{
  "name": "osrs-tracker-web",
  "version": "0.0.0",
  "private": true,
  "description": "Keep track of everything that matters in Old School RuneScape. Track the latest news, item prices, hiscores, and XP gains.",
  "keywords": [
    "oldschool",
    "runescape",
    "osrs",
    "hiscores",
    "items",
    "price",
    "xp",
    "tracker"
  ],
  "repository": {
    "type": "git",
    "url": "github:osrs-tracker/osrs-tracker-web"
  },
  "license": "Elastic-2.0",
  "author": {
    "name": "Freek Mencke",
    "email": "freek_mencke.dev@outlook.com",
    "url": "https://freekmencke.com"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "npm run sitemap && npm run icons",
    "build": "NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration production",
    "postbuild": "rm -f dist/osrs-tracker-web/browser/index.csr.html",
    "predocker:build": "npm run sitemap && npm run icons",
    "docker:build": "docker build -t freekmencke/osrs-tracker-web:latest .",
    "a11y": "node scripts/a11y/a11y-scan.mjs",
    "check:ge-tax": "node scripts/ge-tax/check-ge-tax.mjs",
    "icons": "node scripts/icons/local-icons.js",
    "sitemap": "npm run sitemap:site && npm run sitemap:index",
    "sitemap:index": "node ./scripts/sitemap/sitemap-index.js",
    "sitemap:site": "node ./scripts/sitemap/sitemap-site.js",
    "lint": "ng lint",
    "prettier": "prettier --write .",
    "prettier:ci": "prettier --check .",
    "start": "ng serve --open",
    "test": "ng test",
    "watch": "ng build --watch --configuration development"
  },
  "prettier": "./.prettierrc.json",
  "dependencies": {
    "@angular/aria": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.5",
    "@lucide/angular": "^1.59.0",
    "@ngrx/signals": "^22.0.1",
    "@osrs-tracker/express-metrics": "^0.2.0",
    "@osrs-tracker/hiscores": "^6.0.0",
    "@osrs-tracker/logger": "^0.3.0",
    "@osrs-tracker/models": "^3.3.0",
    "@resvg/resvg-wasm": "~2.6.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "date-fns": "^4.1.0",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "isbot": "^5.2.2",
    "marked": "^18.1.1",
    "marked-smartypants": "^1.1.12",
    "rxjs": "~7.8.2",
    "satori": "^0.56.2",
    "tslib": "^2.3.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/express": "^5.0.6",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^24.19.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "xml-formatter": "^3.7.0"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "unrs-resolver": false
  }
}
